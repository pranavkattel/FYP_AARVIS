# ── OAuth Method Selection ──
# Choose which OAuth broker to use: "ngrok" or "vps"
# Switch between them by changing this value
OAUTH_METHOD=vps

# ── NGROK Configuration (for temporary testing) ──
# Uncomment and set when OAUTH_METHOD=ngrok
# Note: ngrok free URLs change on restart, so you'll need to update Google Console each time
NGROK_OAUTH_BROKER_URL= https://803f-2001-df4-2b40-cabc-6c6e-3d92-4626-37dd.ngrok-free.app
NGROK_OAUTH_REDIRECT_URI= https://803f-2001-df4-2b40-cabc-6c6e-3d92-4626-37dd.ngrok-free.app/auth/google/callback

# ── VPS Configuration (for production) ──
# Uncomment and set when OAUTH_METHOD=vps
# Requires HTTPS and domain to work with Google OAuth
VPS_OAUTH_BROKER_URL=https://aarvis.laevix.org
VPS_OAUTH_REDIRECT_URI=https://aarvis.laevix.org/auth/google/callback

# ── Active Configuration (auto-set based on OAUTH_METHOD) ──
# These are computed from above; don't edit manually
PUBLIC_BASE_URL=
GOOGLE_OAUTH_REDIRECT_URI=
